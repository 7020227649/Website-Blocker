{
  "manifest_version": 3,
  "name": "Website Blocker",
  "version": "1.3.1",
  "description": "Free, privacy-first Chrome website blocker for students, distracting websites, online games, and adult websites. By Sagar Deshmukh (MSW Web Developer).",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Website Blocker",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
